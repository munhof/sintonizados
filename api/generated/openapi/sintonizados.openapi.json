        "/api/sessions/{session_id}/events": {
            "get": {
                "description": "SSE event 'subtitle', JSON Subtitle payload, id is session-local sequence.\nReplays retained last 200 subtitles; Last-Event-ID resumes. Heartbeats every 15 s.\nSee api/README.md for reset events, retention, reconnect and partial transcript semantics.",
                "operationId": "StreamSubtitles",
                "parameters": [
                    {
                        "name": "session_id",
                        "in": "path",
                        "schema": {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 1,
                            "pattern": "^[a-zA-Z0-9_-]+$"
                        },
                        "required": true
                    },
                    {
                        "name": "Last-Event-ID",
                        "in": "header",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "StreamSubtitles 200 response",
                        "content": {
                            "text/event-stream": {
                                "schema": {
                                    "$ref": "#/components/schemas/StreamSubtitlesOutputPayload"
