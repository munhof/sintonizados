        "/api/sessions/{session_id}/audio": {
            "post": {
                "description": "Ordered PCM16 little-endian mono 16 kHz chunks, 2..32000 bytes, even length.\nSequence starts at 1. Retries of an accepted sequence return 409; never replay silently.",
                "operationId": "IngestAudio",
                "requestBody": {
                    "content": {
                        "application/octet-stream": {
                            "schema": {
                                "$ref": "#/components/schemas/IngestAudioInputPayload"
                            }
                        }
                    },
                    "required": true
                },
                "parameters": [
                    {
                        "name": "session_id",
                        "in": "path",
                        "schema": {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 1,
                            "pattern": "^[a-zA-Z0-9_-]+$"
                        },
                        "required": true
                    },
                    {
                        "name": "X-Audio-Sequence",
                        "in": "header",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "format": "int64"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "IngestAudio 202 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IngestAudioResponseContent"
                                }
                            }
                        }
                    },
                    "400": {
