#!/bin/sh
# Explicit operator commands; nothing deploys as part of local development or CI.
set -eu
cd "$(dirname "$0")/.."
: "${GOOGLE_CLOUD_PROJECT:?Set GOOGLE_CLOUD_PROJECT}"
region=${GOOGLE_CLOUD_REGION:-us-central1}
repository=sintonizados
service=sintonizados
account="sintonizados-runtime@${GOOGLE_CLOUD_PROJECT}.iam.gserviceaccount.com"
image="${region}-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${repository}/gateway:${IMAGE_TAG:-mvp}"
gcloud() {
 podman run --rm -v sintonizados-gcloud:/root/.config/gcloud -v "$PWD:/workspace:Z" -w /workspace gcr.io/google.com/cloudsdktool/google-cloud-cli:stable gcloud --project "$GOOGLE_CLOUD_PROJECT" "$@"
}
case "${1:-help}" in
 init)
  gcloud services enable run.googleapis.com artifactregistry.googleapis.com secretmanager.googleapis.com translate.googleapis.com generativelanguage.googleapis.com
  gcloud artifacts repositories describe "$repository" --location "$region" >/dev/null 2>&1 || gcloud artifacts repositories create "$repository" --location "$region" --repository-format docker
  gcloud iam service-accounts describe "$account" >/dev/null 2>&1 || gcloud iam service-accounts create sintonizados-runtime --display-name 'Sintonizados runtime'
  ;;
 push)
  podman build -t "$image" .
  authfile=$(mktemp /tmp/sintonizados-registry-XXXXXX)
  printf '{}\n' > "$authfile"
  trap 'rm -f "$authfile"' EXIT INT TERM
  gcloud auth print-access-token | podman login --authfile "$authfile" -u oauth2accesstoken --password-stdin "${region}-docker.pkg.dev"
  podman push --authfile "$authfile" "$image"
  ;;
 deploy)
  for secret in sintonizados-operator-token sintonizados-gemini-key sintonizados-translation-key; do
   gcloud secrets add-iam-policy-binding "$secret" --member "serviceAccount:$account" --role roles/secretmanager.secretAccessor >/dev/null
  done
  gcloud run deploy "$service" --image "$image" --region "$region" --service-account "$account" \
    --allow-unauthenticated --port 8080 --cpu 1 --memory 512Mi --concurrency 80 \
    --min 1 --max 1 --max-instances 1 --no-cpu-throttling --timeout 3600 \
    --set-env-vars 'PROVIDER_MODE=google,MAX_SESSIONS=16,GEMINI_MODEL=gemini-3.5-transcribe-live' \
    --set-secrets 'OPERATOR_TOKEN=sintonizados-operator-token:latest,GEMINI_API_KEY=sintonizados-gemini-key:latest,GOOGLE_TRANSLATION_API_KEY=sintonizados-translation-key:latest'
  ;;
 status) gcloud run services describe "$service" --region "$region" --format='value(status.url)' ;;
 *) printf '%s\n' 'Usage: GOOGLE_CLOUD_PROJECT=... ./scripts/cloud {init|push|deploy|status}' ;;
esac
