# Local demonstration only. Replace before exposing beyond localhost.
PROVIDER_MODE=demo
PORT=8080
MAX_SESSIONS=16
OPERATOR_TOKEN=local-demo-change-me
# Google mode needs two provider credentials (never sent to browsers).
GEMINI_API_KEY=
GOOGLE_TRANSLATION_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe-live
# Set laya to classify each final transcript with the separate official service.
DECISION_ENGINE=deterministic
LAYA_URL=http://sintonizados-laya:8000
# Optional bearer credential for a separately secured Laya service (not a Google key).
LAYA_API_KEY=
